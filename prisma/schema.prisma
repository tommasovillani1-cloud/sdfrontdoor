// Element Six Service Desk Front Door — data model (PostgreSQL / Lakebase)
// All operational data, including chat history, lives here. The chunked KB
// text and embeddings live in a Databricks Delta table (kb_chunks), not here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------------------------------
// Enums
// --------------------------------------------------------------------------

enum ConversationStatus {
  active
  resolved
  escalated
}

enum MessageRole {
  user
  assistant
  system
}

enum FeedbackRating {
  up
  down
}

// --------------------------------------------------------------------------
// Identity
// --------------------------------------------------------------------------

model User {
  id          String    @id @default(cuid())
  email       String    @unique // the forwarded identity
  displayName String?   @map("display_name")
  site        String? // from Graph country; "Unknown" when empty
  entraOid          String?   @map("entra_oid") // optional; identity arrives via email
  preferredLanguage String?   @map("preferred_language") // BCP-47 tag from Graph (e.g. "fr-FR")
  isAdmin           Boolean   @default(false) @map("is_admin")
  createdAt   DateTime  @default(now()) @map("created_at")
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at")

  conversations Conversation[]
  feedback      Feedback[]
  auditLogs     AuditLog[]     @relation("ActorAuditLogs")

  @@map("users")
}

// --------------------------------------------------------------------------
// Conversations & messages
// --------------------------------------------------------------------------

model Conversation {
  id          String             @id @default(cuid())
  userId      String             @map("user_id")
  title       String             @default("New conversation")
  status      ConversationStatus @default(active)
  categoryId  String?            @map("category_id")
  startedAt   DateTime           @default(now()) @map("started_at") // reporting date
  resolvedAt  DateTime?          @map("resolved_at")
  escalatedAt DateTime?          @map("escalated_at")
  deletedAt   DateTime?          @map("deleted_at") // soft delete before purge

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  messages    Message[]
  escalations Escalation[]

  @@index([userId, startedAt])
  @@index([status])
  @@index([startedAt])
  @@index([deletedAt])
  @@map("conversations")
}

model Message {
  id             String      @id @default(cuid())
  conversationId String      @map("conversation_id")
  role           MessageRole
  content        String      @db.Text
  model          String? // model that produced an assistant message
  tokensIn       Int?        @map("tokens_in")
  tokensOut      Int?        @map("tokens_out")
  createdAt      DateTime    @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  feedback     Feedback[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

// --------------------------------------------------------------------------
// Categories (ITIL-aligned, editable by admins)
// --------------------------------------------------------------------------

model Category {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  itilMapping String? @map("itil_mapping")
  isActive    Boolean @default(true) @map("is_active")
  sortOrder   Int     @default(0) @map("sort_order")

  conversations Conversation[]

  @@map("categories")
}

// --------------------------------------------------------------------------
// Escalations (one row per handoff, for deflection measurement)
// --------------------------------------------------------------------------

model Escalation {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  toEmail        String   @map("to_email")
  subject        String
  body           String   @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
  @@map("escalations")
}

// --------------------------------------------------------------------------
// Feedback (thumbs up/down on assistant messages)
// --------------------------------------------------------------------------

model Feedback {
  id        String         @id @default(cuid())
  messageId String         @map("message_id")
  userId    String         @map("user_id")
  rating    FeedbackRating
  createdAt DateTime       @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId]) // one vote per user per message
  @@map("feedback")
}

// --------------------------------------------------------------------------
// App settings (system prompt, retention override, ServiceNow config, sync cadence)
// Secrets within value JSON are encrypted with APP_ENCRYPTION_KEY at the app layer.
// --------------------------------------------------------------------------

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("app_settings")
}

// System prompt change history (versioned, per open item decision).
model SystemPromptVersion {
  id        String   @id @default(cuid())
  content   String   @db.Text
  editedBy  String?  @map("edited_by") // actor email
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("system_prompt_versions")
}

// --------------------------------------------------------------------------
// Audit log (all admin actions)
// --------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?  @map("actor_user_id")
  action      String
  target      String?
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  actor User? @relation("ActorAuditLogs", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorUserId])
  @@map("audit_log")
}

// --------------------------------------------------------------------------
// Knowledge base source. The KB is backed by a single selected SharePoint
// folder. This row records which folder is the source; the daily Databricks
// job enumerates it (Graph delta), and the chunk text + embeddings live in the
// Databricks kb_chunks Delta table. The job owns all incremental (new/updated/
// deleted) state and its delta cursor in Databricks, not here.
// --------------------------------------------------------------------------

model KbSource {
  id                String   @id @default(cuid())
  siteId            String   @map("site_id")
  siteName          String   @map("site_name")
  driveId           String   @map("drive_id")
  driveName         String   @map("drive_name")
  folderItemId      String   @map("folder_item_id")
  folderPath        String   @map("folder_path")
  folderName        String   @map("folder_name")
  includeSubfolders Boolean  @default(true) @map("include_subfolders")
  selectedBy        String?  @map("selected_by") // actor email
  selectedAt        DateTime @default(now()) @map("selected_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("kb_source")
}

// --------------------------------------------------------------------------
// Delegated SharePoint browse tokens (per admin). Populated by the interactive
// OAuth auth-code flow so an admin can browse SharePoint as themselves. Access
// and refresh tokens are encrypted at rest with APP_ENCRYPTION_KEY (crypto.ts).
// Distinct from the app-only Graph/sync identities.
// --------------------------------------------------------------------------

model SharePointBrowseToken {
  userId       String   @id @map("user_id")
  accessToken  String   @map("access_token") // encrypted
  refreshToken String   @map("refresh_token") // encrypted
  expiresAt    DateTime @map("expires_at")
  scope        String?
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("sharepoint_browse_tokens")
}
