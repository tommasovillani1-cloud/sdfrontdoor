# ============================================================================
# Element Six Service Desk Front Door — environment configuration
# Copy to .env and fill in. Never commit .env.
# ============================================================================

# --- Database (Databricks Lakebase Postgres) -------------------------------
# Standard Postgres URL. Lakebase requires SSL, so keep sslmode=require.
# If the password is a rotating Lakebase OAuth token, refresh this value when
# it expires (a startup token-refresh helper can be added if needed).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/databricks_postgres?sslmode=require"

# --- Microsoft Graph -------------------------------------------------------
# One service principal (app-only token). Reads displayName + country/site.
# Same app registration that would otherwise have handled sign-in: one client ID.
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_TENANT_ID=

# --- SharePoint browse (delegated, admin interactive OAuth) ----------------
# Dedicated Entra app for the admin folder browser. The admin signs in, so they
# only see SharePoint they can access. Distinct from GRAPH_* above. Requires
# delegated Sites.Read.All + offline_access + User.Read, and a redirect URI of
# <app>/api/admin/sharepoint/auth/callback registered on the app registration.
SHAREPOINT_BROWSE_TENANT_ID=
SHAREPOINT_BROWSE_CLIENT_ID=
SHAREPOINT_BROWSE_CLIENT_SECRET=
# APP_BASE_URL=                   # optional; overrides the OAuth redirect base
                                  # (else derived from X-Forwarded-* headers)

# --- SharePoint sync (app-only; consumed by the Databricks job) ------------
# Dedicated Entra app used by the daily sync job to enumerate the selected
# SharePoint folder. Separate from GRAPH_* and the browse app. The Databricks
# job reads these from its own secret scope; declared here for parity.
SHAREPOINT_SYNC_TENANT_ID=
SHAREPOINT_SYNC_CLIENT_ID=
SHAREPOINT_SYNC_CLIENT_SECRET=

# --- AI provider (provider-abstracted; model is swappable) -----------------
AI_PROVIDER=databricks            # databricks | anthropic | openai-compatible
AI_BASE_URL=                      # e.g. https://<workspace>.databricks.net/serving-endpoints
AI_API_KEY=                       # Databricks PAT or provider key
AI_MODEL=claude-sonnet-4-6        # the model to use, settable here
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.2

# --- Service Desk escalation ----------------------------------------------
SERVICE_DESK_EMAIL=European.Servicedesk@angloamerican.com

# --- Retention -------------------------------------------------------------
CONVERSATION_RETENTION_MONTHS=6

# --- Bootstrap admins (comma separated) ------------------------------------
DEFAULT_ADMINS=tommaso.villani@e6.com,sian.romani@e6.com

# --- Encryption at rest for stored secrets (e.g. ServiceNow creds) ---------
# 32-byte key, base64 or hex. Generate: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# --- Knowledge base (Databricks AI Search) ---------------------------------
# Leave KB_* blank to run with a completely empty KB (app still boots/runs).
DATABRICKS_HOST=
DATABRICKS_TOKEN=                 # workspace token / app SP for Volume, Jobs, AI Search
KB_VOLUME_PATH=                   # UC Volume, e.g. /Volumes/<catalog>/<schema>/<volume>
KB_DELTA_TABLE=                   # e.g. <catalog>.<schema>.kb_chunks
KB_VECTOR_ENDPOINT=               # AI Search endpoint name
KB_VECTOR_INDEX=                  # <catalog>.<schema>.<index>
KB_PROCESSING_JOB_ID=             # Databricks Job that parses/chunks uploads
KB_SYNC_CADENCE=daily             # hourly | every_6_hours | daily (admin-editable in UI)

# --- ServiceNow (disabled at launch; live values managed in admin UI) ------
SERVICENOW_ENABLED=false

# --- Local development identity simulation ---------------------------------
# Databricks forwards identity headers in production. Locally there is no proxy,
# so set these to simulate a signed-in user. Ignored when real X-Forwarded-*
# headers are present. Leave DEV_FORWARDED_EMAIL blank in production.
DEV_FORWARDED_EMAIL=tommaso.villani@e6.com
DEV_FORWARDED_NAME=Tommaso Villani

# --- Retention purge endpoint protection -----------------------------------
# Shared secret required to call POST /api/cron/retention.
CRON_SECRET=change-me-in-production
